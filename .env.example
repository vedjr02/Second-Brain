# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Any long random string. Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook call; the backend rejects requests without it.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Local SQLite database file (created automatically on first boot).
# Default: second_brain.db in the project root. Change if you want it elsewhere.
SQLITE_PATH=second_brain.db

# Google AI Studio API key (https://aistudio.google.com/apikey). Required:
# message classification, reminder date parsing, image descriptions, answers.
# Kimi (Moonshot) API key from https://platform.moonshot.ai
LLM_API_KEY=change-me

# Public HTTPS origin Telegram will call. Leave empty locally; set it on Render
# to https://<your-service>.onrender.com and the app registers the webhook at boot.
WEBHOOK_BASE_URL=

# --- Reminders --------------------------------------------------------------

# Your IANA timezone. Reminder times are parsed and echoed in this zone.
# Examples: Europe/Berlin, Asia/Kolkata, America/New_York.
USER_DISPLAY_TIMEZONE=UTC

# Shared secret for the reminder cron. The GitHub Actions workflow calls
# POST /check-reminders with "Authorization: Bearer <REMINDER_CHECK_SECRET>".
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the endpoint (it returns 404).
REMINDER_CHECK_SECRET=

# --- Optional tuning (defaults shown) --------------------------------------
# Gemini model for classification + answers.
# LLM model id. Leave EMPTY to auto-pick the best Kimi model from your
# account's model list. Set explicitly to override (e.g. kimi-k3).
LLM_MODEL=
# Optional vision-capable model for image descriptions (photos work with
# OCR alone without it). Leave empty unless you have a VL model.
LLM_VISION_MODEL=
# API base URL. Kimi (Moonshot): https://api.moonshot.ai/v1
LLM_BASE_URL=https://api.moonshot.ai/v1
# Minimum cosine similarity (0..1) for a memory chunk to count as a match.
SIMILARITY_THRESHOLD=0.35
# How many memory chunks to feed into an answer.
SEARCH_TOP_K=5
